{
  "sourceLanguage": "en",
  "strings": {
    "app.update.action.check": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        }
      }
    },
    "app.update.action.checking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
        }
      }
    },
    "app.update.action.download": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download for This Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载适用于此 Mac 的新版"
          }
        }
      }
    },
    "app.update.action.later": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        }
      }
    },
    "app.update.action.open_applications": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Applications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“应用程序”文件夹"
          }
        }
      }
    },
    "app.update.action.open_downloads": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Downloads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“下载”文件夹"
          }
        }
      }
    },
    "app.update.action.open_release_page": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Release Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Release 页面"
          }
        }
      }
    },
    "app.update.action.redownload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新下载"
          }
        }
      }
    },
    "app.update.action.release_notes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Release Notes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看更新内容"
          }
        }
      }
    },
    "app.update.action.retry_download": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Download Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新尝试下载"
          }
        }
      }
    },
    "app.update.action.reveal_new_app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show New App in Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中显示新版"
          }
        }
      }
    },
    "app.update.action.show_install_guide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Installation Guide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看安装引导"
          }
        }
      }
    },
    "app.update.action.view": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看更新"
          }
        }
      }
    },
    "app.update.architecture.apple_silicon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple silicon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 芯片"
          }
        }
      }
    },
    "app.update.architecture.intel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Intel 芯片"
          }
        }
      }
    },
    "app.update.asset.detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "app.update.available.compact_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update %@ Available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版 %@ 可用"
          }
        }
      }
    },
    "app.update.available.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the build made for this Mac. After you replace the App, the new version finishes updating its managed services and Agent integrations for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载为这台 Mac 准备的版本。替换 App 后，新版会为你完成托管服务和 Agent 集成的更新。"
          }
        }
      }
    },
    "app.update.available.title_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ Is Available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版 %@ 可用"
          }
        }
      }
    },
    "app.update.check.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software Update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件更新"
          }
        }
      }
    },
    "app.update.checking.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App is looking for the latest verified release for this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 正在查找适用于此 Mac、经过安全校验的最新正式版本。"
          }
        }
      }
    },
    "app.update.checking.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking GitHub Releases"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查 GitHub Release"
          }
        }
      }
    },
    "app.update.convergence.action.check_again": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        }
      }
    },
    "app.update.convergence.action.open_connections": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Agent Connections"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Agent 连接"
          }
        }
      }
    },
    "app.update.convergence.action.open_diagnostics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Service & Diagnostics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开服务与诊断"
          }
        }
      }
    },
    "app.update.convergence.attention.bundled_pets.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This App copy does not contain every verified built-in pet file. Download the official release again, replace the App in Applications, then reopen it; your existing pets and data are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 App 副本没有包含全部已验证的内置宠物文件。请重新下载官方 Release，替换“应用程序”中的 App 后再打开；现有宠物和数据不会丢失。"
          }
        }
      }
    },
    "app.update.convergence.attention.bundled_pets.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundled Pet Files Are Missing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 缺少内置宠物文件"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.conflict_detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The managed location for %@ holds a path the App cannot safely write, and Set Up or Repair skips it while that is true. Expand the Agent to see the exact path in its blocking check, move or restore it, then choose Check Again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的受管位置中有一个本 App 无法安全写入的路径，此状态下“一键设置或修复”不会处理它。请展开对应 Agent 查看阻断检查项中的具体路径，移走或恢复后点击“重新检查”。"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.failed_detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App could not update or verify the managed connector for %@. Expand the Agent, choose Set Up or Repair, follow the instructions, then choose Check All."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 无法更新或验证 %@ 的受管连接组件。请展开对应 Agent，点击“一键设置或修复”，按页面提示处理后再点击“全部检查”。"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.host_detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connector source for %@ was updated, but the Agent command is unavailable, so the active version cannot be verified. Install or update the Agent, fully quit and reopen it, then choose Check All."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的连接组件源已更新，但 Agent 命令当前不可用，无法验证生效版本。请先安装或更新对应 Agent，完全退出并重新打开，再点击“全部检查”。"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.mixed_detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These Agent connections need different fixes: %@. Expand each one, follow its repair, authorization, or restart guidance, then choose Check All."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 Agent 需要分别处理：%@。请逐一展开，按页面提示完成修复、授权或重启，然后点击“全部检查”。"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.title_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action Required for %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 连接需要处理"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.verification_detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection files for %@ were updated, but the running Agent has not loaded and verified them. Fully quit and reopen the Agent, then choose Check All."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的连接文件已经更新，但运行中的 Agent 尚未加载并验证它们。请完全退出并重新打开对应 Agent，再点击“全部检查”。"
          }
        }
      }
    },
    "app.update.convergence.attention.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App could not verify every bundled component or managed Agent integration. You can keep using your existing pets and data, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 未能验证全部随附组件或受管 Agent 集成。你仍可使用现有宠物和数据，然后重试。"
          }
        }
      }
    },
    "app.update.convergence.attention.service.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PetCore did not return a verified current state. Open Service & Diagnostics, choose Recover Service, wait until it is online, then use Check Again on this notice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PetCore 没有返回已验证的最新状态。请打开“服务与诊断”，点击“恢复服务”，等待服务上线后，再在此提示中点击“重新检查”。"
          }
        }
      }
    },
    "app.update.convergence.attention.service.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Local Service Could Not Be Verified"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证本地服务"
          }
        }
      }
    },
    "app.update.convergence.attention.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish Setting Up the Update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成更新设置"
          }
        }
      }
    },
    "app.update.convergence.complete.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local service, CLI, bundled pets, and your managed Agent integrations are ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地服务、CLI、内置宠物和由 App 管理的 Agent 集成都已就绪。"
          }
        }
      }
    },
    "app.update.convergence.complete.title_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated to Version %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已更新至版本 %@"
          }
        }
      }
    },
    "app.update.convergence.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App is updating its local service and the Agent integrations you already use. This normally takes only a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 正在更新本地服务和你已经使用的 Agent 集成，通常只需片刻。"
          }
        }
      }
    },
    "app.update.convergence.maker_blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing the update before starting new pet work"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在完成更新，完成后即可开始新的宠物制作"
          }
        }
      }
    },
    "app.update.convergence.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing the New Version Setup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在完成新版设置"
          }
        }
      }
    },
    "app.update.convergence.waiting.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pet creation or another protected operation is still active. The update will continue automatically as soon as it finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宠物制作或另一项受保护操作仍在进行。任务完成后，更新会自动继续。"
          }
        }
      }
    },
    "app.update.convergence.waiting.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Current Work Comes First"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先让当前任务完成"
          }
        }
      }
    },
    "app.update.current.detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ is the latest stable release."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是最新稳定版本。"
          }
        }
      }
    },
    "app.update.current.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re up to date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已是最新版"
          }
        }
      }
    },
    "app.update.data_reassurance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pets, settings, and history stay exactly where they are."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的宠物、设置和历史会完整保留。"
          }
        }
      }
    },
    "app.update.failure.download_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t Open the Download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能打开下载"
          }
        }
      }
    },
    "app.update.failure.network_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub could not be reached. Nothing changed; check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法连接 GitHub。任何内容都没有改变，请检查网络后重试。"
          }
        }
      }
    },
    "app.update.failure.open_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser did not open the download. Try again, or open the verified Release page and download this Mac’s build there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器未能打开下载。你可以重试，或打开已验证的 Release 页面，在那里下载适合这台 Mac 的版本。"
          }
        }
      }
    },
    "app.update.failure.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check for updates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能检查更新"
          }
        }
      }
    },
    "app.update.failure.verification_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest Release did not pass the App’s safety checks, so no download was offered. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新 Release 未通过 App 的安全校验，因此没有提供下载。请稍后再试。"
          }
        }
      }
    },
    "app.update.install.invalid.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This App copy cannot safely update its bundled components. Download the official release again. Your pets, settings, history, and current work are untouched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 副本无法安全更新随附组件。请重新下载官方 Release；你的宠物、设置、历史与当前工作不会改变。"
          }
        }
      }
    },
    "app.update.install.invalid.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download a Complete Copy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新下载完整版本"
          }
        }
      }
    },
    "app.update.install.required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
