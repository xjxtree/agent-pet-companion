{
  "sourceLanguage": "en",
  "strings": {
    "asset_recovery.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revalidate the pet package and re-extract its cover and nine-action animation assets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新校验桌宠包，并重新提取封面与九动作动画资源。"
          }
        }
      }
    },
    "asset_recovery.diagnostics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Diagnostics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看诊断"
          }
        }
      }
    },
    "asset_recovery.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package still could not produce a valid preview. Review diagnostics for the bounded failure details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌宠包仍无法生成有效预览。请在诊断中查看经过限制的失败详情。"
          }
        }
      }
    },
    "asset_recovery.repair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair Preview"
          }
        },
