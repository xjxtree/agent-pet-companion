      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@” and its app-owned .petpack resources? Nothing is uploaded or retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除“%@”及其本 App 自有 .petpack 资源。此操作不会上传或保留副本。"
          }
        }
      }
    },
    "library.delete.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Pet?"
