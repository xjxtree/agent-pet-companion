    "library.authored_timing_summary.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d frames across %d actions · authored per-frame timing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 帧 · %d 个动作 · 逐帧创作时序"
          }
        }
      }
    },
    "library.bundled.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundled pets can be enabled, exported, and previewed. Customization first prepares a copy draft with a new ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 内置宠物可启用、导出和预览；定制会先准备使用新 ID 的副本草稿。"
          }
        }
      }
    },
    "library.card.accessibility_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select pet %@. Style %@, source %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择宠物 %@，风格：%@，来源：%@"
          }
        }
      }
    },
    "library.card.variant_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Variant %d"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变体 %d"
          }
        }
      }
    },
    "library.copy.active_task": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish or cancel the current AI creation task first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成或取消当前 AI 制作任务"
          }
        }
      }
    },
    "library.copy.brief_contract": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserve the character’s core identifying features and nine-action structure. You can add appearance and motion requirements before creating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留原角色的核心辨识特征与九动作结构，并允许我在开始制作前继续补充外观和动作要求。"
          }
        }
      }
    },
    "library.copy.brief_id_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new copy must use a new stable pet ID: %@. Do not overwrite or reuse the original ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新副本必须使用新的稳定宠物 ID：%@，不得覆盖或复用原 ID。"
          }
        }
      }
    },
    "library.copy.brief_source_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an independent copy based on the bundled read-only pet “%@” (ID: %@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请基于 App 内置宠物“%@”（只读 ID：%@）创作一个独立副本。"
          }
        }
      }
    },
    "library.copy.bundled_only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only bundled read-only pets need a copy before customization."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅 App 内置只读宠物需要先创建副本"
          }
        }
      }
    },
    "library.copy.prepared_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepared a copy draft for %@. Confirm the new ID and creative brief, then start creating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已准备 %@ 的副本草稿；请确认新 ID 和创作要求后开始制作"
          }
        }
      }
    },
    "library.current_info": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical Information"
