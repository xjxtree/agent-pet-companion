    "connections.check.accessibility_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%@，%@"
          }
        }
      }
    },
    "connections.check.description.agent_cli": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether the selected agent command is available to the connection environment. Install or expose the agent CLI, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查连接环境能否使用所选 Agent 命令。若不可用，请安装 Agent CLI 或让当前环境可找到它，然后重新检查。"
          }
        }
      }
    },
    "connections.check.description.agent_version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports the detected host version as diagnostic context. Host versions never block compatibility; the managed connector and live runtime/channel checks decide connection health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把检测到的宿主版本作为诊断信息展示。宿主版本不会阻断兼容性；连接健康由受管连接器及实时宿主/通道检查决定。"
          }
        }
      }
    },
    "connections.check.description.app_server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether Codex App Server is available for connector workflows. Update or enable Codex, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 Codex App Server 是否可用于连接器工作流。请更新或启用 Codex，然后重新检查。"
          }
        }
      }
    },
    "connections.check.description.channel_test": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks only the local diagnostic CLI, RPC, and event persistence path. It does not verify a real agent task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只检查本地诊断 CLI、RPC 与事件持久化链路，不代表真实 Agent 任务已验证。"
          }
        }
      }
    },
    "connections.check.description.claude_hooks_policy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether Claude Hooks policies permit Agent Pet Companion. disableAllHooks, allowManagedHooksOnly, or another managed policy may block Hooks; adjust the policy or contact your administrator, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 Claude Hooks 策略是否允许 Agent Pet Companion。disableAllHooks、allowManagedHooksOnly 或其他管理策略可能阻止 Hooks；请调整策略或联系管理员，然后重新检查。"
          }
        }
      }
    },
    "connections.check.description.event_cli": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether Agent Pet Companion's local event command is installed. Use Install or Repair if it is missing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 Agent Pet Companion 的本地事件命令是否已安装。若缺失，请使用“安装或修复”。"
          }
        }
      }
    },
    "connections.check.description.event_delivery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether the local event command can reach PetCore. Repair the connector or local service, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查本地事件命令能否连接 PetCore。请修复连接器或本地服务，然后重新检查。"
          }
        }
      }
    },
    "connections.check.description.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks a supported connection condition. Refresh the check and follow the managed-connection guidance if it still needs attention."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查一个受支持的连接条件。请刷新检查；若仍需处理，请按受管连接指引操作。"
          }
        }
      }
    },
    "connections.check.description.host_runtime": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether the agent host loaded its managed connector. Restart the agent after a repair, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 Agent 宿主是否已加载受管连接器。修复后请重启 Agent，再重新检查。"
          }
        }
      }
    },
    "connections.check.description.host_server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether the OpenCode server is available to the managed connector. Update or restart OpenCode, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 OpenCode Server 是否可供受管连接器使用。请更新或重启 OpenCode，然后重新检查。"
          }
        }
      }
    },
    "connections.check.description.host_verification": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks host trust and connector loading for this agent. Follow the host guidance and run a real agent task before checking again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查该 Agent 的宿主信任与连接器加载情况。请按宿主指引处理并运行一次真实 Agent 任务，再重新检查。"
          }
        }
      }
    },
    "connections.check.description.managed_connector": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks the app-managed connector files and settings. Review the managed locations, then use Install or Repair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 App 管理的连接器文件与设置。请先查看受管位置，再使用“安装或修复”。"
          }
        }
      }
    },
    "connections.check.detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status: %@. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态：%@。%@"
          }
        }
      }
    },
    "connections.check.evidence.codex_trust_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld disabled · %ld modified · %ld untrusted of %ld. Review and trust these hooks in Codex, then recheck."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %4$ld 个 Hook：未启用 %1$ld、已修改 %2$ld、未信任 %3$ld。请在 Codex 中审查并信任后重新检查。"
          }
        }
      }
    },
    "connections.check.evidence.version_missing_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not return version information. This is non-blocking; use the connector and runtime/channel results."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未返回版本信息。此项不阻断连接，请以连接器及宿主/通道检查结果为准。"
          }
        }
      }
    },
    "connections.check.evidence.version_supported_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected %@ for %@. This is informational; compatibility is verified by the managed connector and live runtime/channel checks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到 %@（%@）。此项仅供诊断；兼容性由受管连接器及实时宿主/通道检查验证。"
          }
        }
      }
    },
    "connections.check.evidence.version_unverified_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected %@ for %@. Version information is non-blocking; use the connector and runtime/channel results."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到 %@（%@）。版本信息不阻断连接，请以连接器及宿主/通道检查结果为准。"
          }
        }
      }
    },
    "connections.check.evidence.version_update_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected %@ for %@. Host versions do not gate compatibility; update %@ only if its own runtime check fails."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到 %@（%@）。宿主版本不作为兼容性门槛；仅在 %@ 自身运行检查失败时再更新。"
          }
        }
      }
    },
    "connections.check.name.agent_cli": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent CLI"
          }
        },
