    "onboarding.connect.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App checks supported Agents on this Mac and shows only what you can act on. Project folders are never connection settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 会检查这台 Mac 上支持的 Agent，只显示你可以处理的状态。项目目录从来不是连接设置。"
          }
        }
      }
    },
    "onboarding.connect.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your Agents"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你的 Agent"
          }
        }
      }
    },
    "onboarding.demo.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch how the pet communicates an Agent's state before you run your first real task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在运行第一个真实任务之前，先看看桌宠会怎样表达 Agent 的状态。"
          }
        }
      }
    },
