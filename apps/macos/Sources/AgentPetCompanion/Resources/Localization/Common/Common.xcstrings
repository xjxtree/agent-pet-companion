    "onboarding.choose.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one of the three companions included with the App. Each preview uses the pet's real motion assets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 App 内置的三只桌宠中选择一只。这里播放的是宠物包中的真实动作素材。"
          }
        }
      }
    },
