{
  "sourceLanguage": "en",
  "strings": {
    "overlay.action.handle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去处理"
          }
        }
      }
    },
    "overlay.action.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        }
      }
    },
    "overlay.activity.command": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running a command"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在运行命令"
          }
        }
      }
    },
    "overlay.activity.compaction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacting context"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在压缩上下文"
          }
        }
      }
    },
    "overlay.activity.file": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working with files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理文件"
          }
        }
      }
    },
    "overlay.activity.file_change": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在修改文件"
          }
        }
      }
    },
    "overlay.activity.image": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working with an image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理图像"
          }
        }
      }
    },
    "overlay.activity.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessing the network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在访问网络"
          }
        }
      }
    },
    "overlay.activity.plan": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating the plan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新计划"
          }
        }
      }
    },
    "overlay.activity.search": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在搜索"
          }
        }
      }
    },
    "overlay.activity.subagent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordinating a sub-agent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在协调子 Agent"
          }
        }
      }
    },
    "overlay.activity.thinking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在思考"
          }
        }
      }
    },
    "overlay.activity.tool": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using a tool"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在调用工具"
          }
        }
      }
    },
    "overlay.bubble.close_accessibility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close session bubble"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭会话气泡"
          }
        }
      }
    },
    "overlay.bubble.close_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides this session bubble without closing the Agent session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏此会话气泡，但不会关闭 Agent 会话"
          }
        }
      }
    },
    "overlay.bubble.collapse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse Bubble"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起气泡"
          }
        }
      }
    },
    "overlay.bubble.count_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %d sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，共 %d 个会话"
          }
        }
      }
    },
    "overlay.bubble.expand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand Bubble"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开气泡"
          }
        }
      }
    },
    "overlay.detail.blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task is blocked. Open the agent for details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务遇到错误，请打开 Agent 查看详情。"
          }
        }
      }
    },
    "overlay.detail.completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent finished the task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 已完成任务。"
          }
        }
      }
    },
    "overlay.detail.needs_input": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the agent to approve, answer, or decide."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请回到 Agent 完成确认、回答或决策。"
          }
        }
      }
    },
    "overlay.detail.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest result is complete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新结果已完成。"
          }
        }
      }
    },
    "overlay.detail.running": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task has started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务已开始。"
          }
        }
      }
    },
    "overlay.help.dismiss": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse from the list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从列表收起"
          }
        }
      }
    },
    "overlay.help.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开会话"
          }
        }
      }
    },
    "overlay.help.open_and_dismiss": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open session and collapse it from the list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开会话并从列表收起"
          }
        }
      }
    },
    "overlay.help.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session cannot be opened"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前会话不可打开"
          }
        }
      }
    },
    "overlay.idle.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active agent session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无活跃 Agent 会话。"
          }
        }
      }
    },
    "overlay.pet.accessibility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop pet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌宠"
          }
        }
      }
    },
    "overlay.pet.accessibility_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to expand or collapse the session bubble. Drag with the primary button. Right-click for quick actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击展开或收起会话气泡；按住左键拖动，右击打开快捷菜单"
          }
        }
      }
    },
    "overlay.pet.no_pet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No desktop pet is enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未启用桌宠"
          }
        }
      }
    },
    "overlay.pet.open_quick_menu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Quick Actions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开快捷菜单"
          }
        }
      }
    },
    "overlay.session.accessibility_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，%@，%@"
          }
        }
      }
    },
    "overlay.session.alias_title_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ session %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会话 %@"
          }
        }
      }
    },
    "overlay.session.dismiss": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide This Session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起此会话"
          }
        }
      }
    },
    "overlay.session.navigation_degraded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Agent app opened, but the exact session could not be reached. The message was kept; try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开 Agent App，但未能到达对应会话；消息已保留，请重试。"
          }
        }
      }
    },
    "overlay.session.navigation_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open this Agent session. The message was kept; check the app and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能打开对应 Agent 会话；消息已保留，请检查 App 后重试。"
          }
        }
      }
    },
    "overlay.session.navigation_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Agent session cannot be opened. The message was kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Agent 会话不可打开，消息已保留。"
          }
        }
      }
    },
    "overlay.session.title_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会话"
          }
        }
      }
    },
    "overlay.sessions.collapse_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse %d sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起 %d 个会话"
          }
        }
      }
    },
    "overlay.sessions.expand_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand %d sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开 %d 个会话"
          }
        }
      }
    },
    "overlay.sessions.more_control_center_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View %d more in Control Center"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在控制中心查看其余 %d 个会话"
          }
        }
      }
    },
    "overlay.sessions.more_detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d more sessions are available in Control Center"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %d 个会话，可在控制中心查看"
          }
        }
      }
    },
    "overlay.sessions.more_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More active sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多活跃会话"
          }
        }
      }
    },
    "overlay.status.blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已阻塞"
          }
        }
      }
    },
    "overlay.status.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
