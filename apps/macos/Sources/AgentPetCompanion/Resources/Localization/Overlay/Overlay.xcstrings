          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        }
      }
    },
    "overlay.status.needs_input": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要输入"
          }
        }
      }
    },
    "overlay.status.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待查看"
          }
        }
      }
    },
    "overlay.status.running": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Started"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开始"
          }
        }
      }
    },
    "overlay.status.tool": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using a tool"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行工具"
          }
