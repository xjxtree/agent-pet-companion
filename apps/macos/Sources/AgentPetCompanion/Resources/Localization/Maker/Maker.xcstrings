    "studio.baseline.restoring_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The submitted validated baseline appears after PetCore restores the session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PetCore 恢复会话后会显示已提交的校验基线。"
          }
        }
      }
    },
    "studio.baseline.safety": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assets being generated do not replace this preview. A new revision is committed atomically only after validation succeeds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成中的资源不会替换此预览；只有校验成功后才原子提交新 revision。"
          }
        }
      }
    },
    "studio.baseline.target_state": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标状态"
          }
        }
      }
    },
    "studio.baseline.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitted Baseline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已提交基线"
          }
        }
      }
    },
    "studio.baseline.unavailable_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact submitted revision could not be validated. The current pet preview is not substituted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法校验已提交的确切 revision；不会用当前宠物预览替代。"
          }
        }
      }
    },
    "studio.baseline.unavailable_title": {
      "localizations": {
