      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference image %d"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考图 %d"
          }
        }
      }
    },
    "studio.brief.references_contract": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 4 PNG, JPG, or WebP images · 20 MiB each · 40 MiB total · 16 MP each"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 4 张 PNG、JPG 或 WebP · 单张 20 MiB · 总计 40 MiB · 单张 1600 万像素"
          }
        }
      }
    },
    "studio.brief.references_drop_count_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d selected · Add more"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择 %d 张，继续添加"
          }
        }
      }
    },
    "studio.brief.references_drop_empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop images here, or choose files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入图片，或点按选择"
          }
        }
      }
