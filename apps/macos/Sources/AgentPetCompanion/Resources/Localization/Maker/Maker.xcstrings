    "studio.brief.high_quality_unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-resolution pets are ready to use after import, but the built-in Codex Studio can create or revise only Low and Standard packages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高分辨率宠物包导入后可以直接使用，但 App 内置 Codex Studio 仅支持制作或修改标清与标准宠物包。"
          }
        }
      }
    },
    "studio.brief.new_pet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Pet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新宠物"
          }
        }
