    "studio.session.legacy_checkpoint_failure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task stopped at the old fixed continuation limit; the Codex App Server connection did not fail. The original job, conversation, assets, and passed QA are preserved. Choose Continue to resume from the existing workspace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务由旧版固定续接次数上限停止，并非 Codex App Server 连接故障。原 job、Codex 会话、素材和已通过 QA 均已保留；可点击“继续制作”从当前工作区接着运行。"
          }
        }
      }
    },
    "studio.session.output_contract_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result must include idle, thinking, tool, waiting, done, and failed; every state uses explicit per-frame timing and playback without runtime retiming."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
