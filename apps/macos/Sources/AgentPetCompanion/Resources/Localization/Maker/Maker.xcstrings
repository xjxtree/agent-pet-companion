        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考图（可选）"
          }
        }
      }
    },
    "studio.brief.references_issue.invalid_content": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file contents do not match a valid PNG, JPG, or WebP image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件内容不是有效且格式匹配的 PNG、JPG 或 WebP 图片。"
          }
        }
      }
    },
    "studio.brief.references_issue.reselection_required_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select %d reference image(s) again before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试前请重新选择 %d 张参考图。"
          }
        }
      }
    },
    "studio.brief.references_issue.too_large": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each reference image must be 20 MiB or smaller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张参考图不得超过 20 MiB。"
          }
        }
      }
    },
    "studio.brief.references_issue.too_many": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add at most 4 reference images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考图最多可添加 4 张。"
          }
        }
      }
    },
    "studio.brief.references_issue.too_many_pixels": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each reference image must contain no more than 16 megapixels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张参考图不得超过 1600 万像素。"
          }
        }
      }
    },
    "studio.brief.references_issue.total_too_large": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference images must total 40 MiB or less."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考图总大小不得超过 40 MiB。"
          }
        }
