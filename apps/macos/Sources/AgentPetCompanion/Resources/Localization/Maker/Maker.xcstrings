    },
    "studio.brief.quality_contract_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 9 authored actions · Animation timing is fixed per revision"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 9 个创作动作 · 动画时序随 revision 固定"
          }
