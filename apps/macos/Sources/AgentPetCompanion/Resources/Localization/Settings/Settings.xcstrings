    "config.advanced.appearance.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparency, idle behavior, context menu, and pointer interaction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透明度、空闲行为、右击菜单与指针交互。"
