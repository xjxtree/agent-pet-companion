      }
    },
    "config.attention_preset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message Attention"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息提醒"
          }
        }
      }
    },
    "config.attention_preset.custom_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your per-event choices are customized. Open Advanced Message Settings to review them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已自定义逐事件选择，可展开“高级消息设置”查看。"
          }
        }
      }
    },
    "config.auto_hide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-collapse When Idle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲时自动收起"
          }
        }
      }
    },
    "config.auto_hide.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the bubble while idle and reveal it for events."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲时隐藏气泡，有事件时自动显示"
          }
        }
      }
    },
    "config.bubble_font_scale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bubble Text Size"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "气泡字号"
          }
        }
      }
    },
    "config.bubble_font_scale.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the desktop bubble text size. Standard keeps the current size; Larger scales every bubble text style together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置桌面消息气泡的文字大小。标准保持当前字号，更大会按同一比例放大气泡内所有文字。"
          }
        }
      }
    },
    "config.context_menu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context Menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右击菜单"
          }
        }
      }
    },
    "config.context_menu.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click the desktop pet for quick actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右击桌宠打开快捷菜单"
          }
        }
      }
    },
    "config.current_pet.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current pet: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前宠物：%@"
          }
