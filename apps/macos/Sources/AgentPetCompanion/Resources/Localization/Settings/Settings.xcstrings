        }
      }
    },
    "config.advanced.messages": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced Message Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级消息设置"
          }
        }
      }
    },
    "config.advanced.messages.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent sources, individual events, timeout, and multi-session display."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 来源、逐事件、收起时间与多会话显示。"
