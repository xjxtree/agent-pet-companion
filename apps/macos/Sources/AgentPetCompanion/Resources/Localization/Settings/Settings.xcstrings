    "config.display_appearance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display & Appearance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示与外观"
          }
        }
      }
    },
    "config.display_clarity.limit_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ source is sharpest up to %d pt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@素材在 %d pt 以内最清晰。"
          }
        }
      }
    },
    "config.display_clarity.warning_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ source may look softer above %d pt; display size remains unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@素材超过 %d pt 后可能稍显柔和；显示尺寸不会被限制。"
          }
        }
      }
    },
    "config.display_size": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display Size"
          }
        },
