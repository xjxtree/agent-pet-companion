    "config.event.done_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task is complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务已完成"
          }
        }
      }
    },
    "config.event.failed_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务执行失败"
          }
        }
      }
    },
    "config.event.plan_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Agent updated its plan; the pet uses its Thinking action"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 更新了规划；宠物使用“思考”动作"
          }
        }
      }
    },
    "config.event.reaction_mapping": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badges show stable, filtered session events. Started has no pet action; Thinking and Planning both use the pet's Thinking action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话标识仅显示稳定、经过筛选的事件。开始事件没有宠物动作；思考与规划事件都使用宠物的“思考”动作。"
          }
        }
      }
    },
    "config.event.start_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was accepted; this event does not trigger a pet action"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 已接收请求；开始事件不触发宠物动作"
          }
        }
      }
    },
    "config.event.thinking_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host explicitly reported stable reasoning activity; the pet uses its Thinking action"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宿主明确上报了稳定的思考或推理活动；宠物使用“思考”动作"
          }
        }
      }
    },
    "config.event.tool_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent is using a local tool"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 正在调用本地工具"
          }
        }
      }
    },
    "config.event.waiting_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Agent is paused until you approve, answer, or decide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 已暂停，必须等你确认、回答或决策后才能继续"
          }
        }
      }
    },
    "config.group_display": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default Multi-session Display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多会话默认显示"
          }
        }
      }
    },
    "config.group_display.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can switch a bubble temporarily without changing this global preference."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "气泡中可以为本次临时切换，不会覆盖这里的全局偏好。"
          }
        }
      }
    },
    "config.group_sessions_by_agent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group Sessions by Agent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Agent 聚合会话"
          }
        }
      }
    },
    "config.group_sessions_by_agent.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, each Agent owns one expandable card. When off, every session becomes its own card in one global stack, stably ordered by attention state and new turns."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开时，每个 Agent 使用一张可展开的聚合卡；关闭时，每个会话独立成卡并进入一个全局折叠栈，按注意力状态与新轮次稳定排序。"
          }
        }
      }
    },
    "config.language_accessibility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 语言"
          }
        }
      }
