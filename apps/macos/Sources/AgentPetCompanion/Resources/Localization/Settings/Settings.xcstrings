    "config.language_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the Control Center, desktop pet, menus, and accessibility text immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即切换控制中心、桌宠、菜单和无障碍文字的语言。"
