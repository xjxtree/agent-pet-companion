    "config.persistence_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for You and Failed sessions remain visible regardless of the normal message timeout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“等待你操作”和“执行失败”的会话始终保持显示，不受普通消息收起时间影响。"
          }
        }
