    "app.update.convergence.attention.service.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PetCore did not return a verified current state. Open Service & Diagnostics, choose Recover Service, wait until it is online, then use Check Again on this notice."
          }
