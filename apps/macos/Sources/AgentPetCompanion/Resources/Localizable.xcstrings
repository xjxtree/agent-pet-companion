      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        }
      }
    },
    "app.update.convergence.attention.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App could not verify every bundled component or managed Agent integration. You can keep using your existing pets and data, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 未能验证全部随附组件或受管 Agent 集成。你仍可使用现有宠物和数据，然后重试。"
          }
        }
      }
    },
    "app.update.convergence.attention.bundled_pets.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This App copy does not contain every verified built-in pet file. Download the official release again, replace the App in Applications, then reopen it; your existing pets and data are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 App 副本没有包含全部已验证的内置宠物文件。请重新下载官方 Release，替换“应用程序”中的 App 后再打开；现有宠物和数据不会丢失。"
          }
        }
      }
    },
    "app.update.convergence.attention.bundled_pets.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundled Pet Files Are Missing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 缺少内置宠物文件"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.conflict_detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The managed location for %@ holds a path the App cannot safely write, and Set Up or Repair skips it while that is true. Expand the Agent to see the exact path in its blocking check, move or restore it, then choose Check Again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的受管位置中有一个本 App 无法安全写入的路径，此状态下“一键设置或修复”不会处理它。请展开对应 Agent 查看阻断检查项中的具体路径，移走或恢复后点击“重新检查”。"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.failed_detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App could not update or verify the managed connector for %@. Expand the Agent, choose Set Up or Repair, follow the instructions, then choose Check All."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 无法更新或验证 %@ 的受管连接组件。请展开对应 Agent，点击“一键设置或修复”，按页面提示处理后再点击“全部检查”。"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.host_detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connector source for %@ was updated, but the Agent command is unavailable, so the active version cannot be verified. Install or update the Agent, fully quit and reopen it, then choose Check All."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的连接组件源已更新，但 Agent 命令当前不可用，无法验证生效版本。请先安装或更新对应 Agent，完全退出并重新打开，再点击“全部检查”。"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.mixed_detail_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These Agent connections need different fixes: %@. Expand each one, follow its repair, authorization, or restart guidance, then choose Check All."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 Agent 需要分别处理：%@。请逐一展开，按页面提示完成修复、授权或重启，然后点击“全部检查”。"
          }
        }
      }
    },
    "app.update.convergence.attention.connectors.title_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action Required for %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
