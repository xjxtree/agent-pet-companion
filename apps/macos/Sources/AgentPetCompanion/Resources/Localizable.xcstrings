        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地优先的 macOS 桌面宠物，让 Codex、Claude Code、Pi 与 OpenCode 的工作状态安静地出现在桌面。"
          }
        }
      }
    },
