    "app.update.available.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the build made for this Mac. After you replace the App, the new version finishes updating its managed services and Agent integrations for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载为这台 Mac 准备的版本。替换 App 后，新版会为你完成托管服务和 Agent 集成的更新。"
          }
        }
      }
    },
    "app.update.available.title_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ Is Available"
          }
        },
        "zh-Hans": {
