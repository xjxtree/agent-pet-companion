{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpetcompanion.local/schemas/pet-brief.schema.json",
  "title": "Agent Pet Companion Pet Brief — V2 Safe Producer Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "style", "quality", "states"],
  "properties": {
    "schema_version": { "const": "apc.pet-brief.v1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "style": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
    "quality": { "enum": ["low", "standard"] },
    "description": { "type": ["string", "null"], "maxLength": 8000 },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "provenance"],
      "properties": {
        "generator": { "$ref": "#/$defs/boundedText" },
        "provenance": { "$ref": "#/$defs/boundedText" },
        "skill_helper": { "$ref": "#/$defs/boundedText" },
        "preview_only": { "type": "boolean" }
      }
    },
    "ai_brief": { "type": ["object", "null"], "maxProperties": 64 },
    "visual_brief": { "type": "string", "maxLength": 8000 },
    "render_notes": { "type": "string", "maxLength": 8000 },
    "palette": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "anyOf": [
          { "type": "string", "minLength": 1, "maxLength": 160 },
          { "type": "object", "maxProperties": 8 }
        ]
      }
    },
    "references": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/referencePath" }
    },
    "states": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/stateBrief" },
      "allOf": [
        { "contains": { "$ref": "#/$defs/idleBrief" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/startBrief" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/toolBrief" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/waitingBrief" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/reviewBrief" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/doneBrief" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/failedBrief" }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "state_frame_counts", "render_size"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/manifestState" }
        },
        "state_frame_counts": { "$ref": "#/$defs/stateFrameCounts" },
        "render_size": { "$ref": "#/$defs/renderSize" }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+(?:/[A-Za-z0-9._-]+)?$"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "quality": { "const": "low" } }, "required": ["quality"] },
      "then": {
        "properties": {
          "runtime": {
            "properties": { "render_size": { "$ref": "#/$defs/lowSize" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "quality": { "const": "standard" } }, "required": ["quality"] },
      "then": {
        "properties": {
          "runtime": {
            "properties": { "render_size": { "$ref": "#/$defs/standardSize" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "\\S"
    },
    "stateName": {
      "enum": ["idle", "start", "tool", "waiting", "review", "done", "failed"]
    },
    "frameDurations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 40,
      "items": { "type": "integer", "minimum": 50, "maximum": 2000 }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["loop", "once_hold", "periodic", "burst_then_settle"] },
        "entry_repeat_count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "settle_frame_index": { "type": "integer", "minimum": 0, "maximum": 39 },
        "cooldown_ms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0, "maximum": 86400000 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "loop" } }, "required": ["mode"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["settle_frame_index"] },
                { "required": ["cooldown_ms"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "once_hold" } }, "required": ["mode"] },
          "then": {
            "required": ["settle_frame_index"],
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["cooldown_ms"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "periodic" } }, "required": ["mode"] },
          "then": {
            "required": ["cooldown_ms"],
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["settle_frame_index"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "burst_then_settle" } }, "required": ["mode"] },
          "then": {
            "required": ["entry_repeat_count", "settle_frame_index"],
            "not": { "required": ["cooldown_ms"] }
          }
        }
      ]
    },
    "stateBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion",
        "frame_durations_ms",
        "playback",
        "reduced_motion_frame_index"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/stateName" },
        "state": { "$ref": "#/$defs/stateName" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "motion": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
        "frame_durations_ms": { "$ref": "#/$defs/frameDurations" },
        "playback": { "$ref": "#/$defs/playback" },
        "reduced_motion_frame_index": { "type": "integer", "minimum": 0, "maximum": 39 }
      },
      "oneOf": [
        { "required": ["name"], "not": { "required": ["state"] } },
        { "required": ["state"], "not": { "required": ["name"] } }
      ]
    },
    "manifestState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "frames_dir",
        "frame_durations_ms",
        "playback",
        "reduced_motion_frame_index"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/stateName" },
        "frames_dir": { "type": "string", "minLength": 1, "maxLength": 240 },
        "frame_durations_ms": { "$ref": "#/$defs/frameDurations" },
        "playback": { "$ref": "#/$defs/playback" },
        "reduced_motion_frame_index": { "type": "integer", "minimum": 0, "maximum": 39 }
      }
    },
    "idleBrief": {
      "type": "object",
      "anyOf": [
        { "properties": { "name": { "const": "idle" } }, "required": ["name"] },
        { "properties": { "state": { "const": "idle" } }, "required": ["state"] }
      ]
    },
    "startBrief": {
      "type": "object",
      "anyOf": [
        { "properties": { "name": { "const": "start" } }, "required": ["name"] },
        { "properties": { "state": { "const": "start" } }, "required": ["state"] }
      ]
    },
    "toolBrief": {
      "type": "object",
      "anyOf": [
        { "properties": { "name": { "const": "tool" } }, "required": ["name"] },
        { "properties": { "state": { "const": "tool" } }, "required": ["state"] }
      ]
    },
    "waitingBrief": {
      "type": "object",
      "anyOf": [
        { "properties": { "name": { "const": "waiting" } }, "required": ["name"] },
        { "properties": { "state": { "const": "waiting" } }, "required": ["state"] }
      ]
    },
    "reviewBrief": {
      "type": "object",
      "anyOf": [
        { "properties": { "name": { "const": "review" } }, "required": ["name"] },
        { "properties": { "state": { "const": "review" } }, "required": ["state"] }
      ]
    },
    "doneBrief": {
      "type": "object",
      "anyOf": [
        { "properties": { "name": { "const": "done" } }, "required": ["name"] },
        { "properties": { "state": { "const": "done" } }, "required": ["state"] }
      ]
    },
    "failedBrief": {
      "type": "object",
      "anyOf": [
        { "properties": { "name": { "const": "failed" } }, "required": ["name"] },
        { "properties": { "state": { "const": "failed" } }, "required": ["state"] }
      ]
    },
    "referencePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "anyOf": [
        { "pattern": "^source/references/[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      ],
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "renderSize": {
      "oneOf": [
        { "$ref": "#/$defs/lowSize" },
        { "$ref": "#/$defs/standardSize" }
      ]
    },
    "renderSizeShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "lowSize": {
      "$ref": "#/$defs/renderSizeShape",
      "properties": { "width": { "const": 192 }, "height": { "const": 208 } }
    },
    "standardSize": {
      "$ref": "#/$defs/renderSizeShape",
      "properties": { "width": { "const": 384 }, "height": { "const": 416 } }
    },
    "stateFrameCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idle", "start", "tool", "waiting", "review", "done", "failed"],
      "properties": {
        "idle": { "type": "integer", "minimum": 2, "maximum": 40 },
        "start": { "type": "integer", "minimum": 2, "maximum": 40 },
        "tool": { "type": "integer", "minimum": 2, "maximum": 40 },
        "waiting": { "type": "integer", "minimum": 2, "maximum": 40 },
        "review": { "type": "integer", "minimum": 2, "maximum": 40 },
        "done": { "type": "integer", "minimum": 2, "maximum": 40 },
        "failed": { "type": "integer", "minimum": 2, "maximum": 40 }
      }
    }
  }
}
