{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpetcompanion.local/schemas/pet-source.schema.json",
  "title": "Agent Pet Companion Pet Source Metadata — V2 Safe Producer Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator", "provenance"],
  "properties": {
    "schema_version": { "const": "apc.pet-source.v1" },
    "generator": { "$ref": "#/$defs/boundedText" },
    "provenance": { "$ref": "#/$defs/boundedText" },
    "created_at": { "type": "string", "format": "date-time" },
    "manifest_id": { "type": "string", "pattern": "^pet_[a-z0-9]+$", "maxLength": 128 },
    "pet_name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "style": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
    "quality": { "enum": ["low", "standard", "high"] },
    "visual_source": {
      "enum": [
        "image-generation",
        "user-reference-derived",
        "reference-image",
        "generated-vector",
        "deterministic-preview",
        "manual",
        "unknown"
      ]
    },
    "states": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/manifestState" }
    },
    "state_frame_counts": { "$ref": "#/$defs/stateFrameCounts" },
    "preview_only": { "type": "boolean" },
    "reference_visual_influence": { "type": "boolean" },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "maxLength": 8000 },
        "style": { "type": "string", "maxLength": 1000 },
        "quality": { "enum": ["low", "standard", "high"] },
        "reference_images": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/referencePath" }
        }
      }
    },
    "reference_files": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/referencePath" }
    },
    "input_reference_count": { "type": "integer", "minimum": 0, "maximum": 4 },
    "copied_reference_count": { "type": "integer", "minimum": 0, "maximum": 4 },
    "ai_brief": { "type": ["object", "null"], "maxProperties": 64 },
    "palette_source": { "type": "string", "minLength": 1, "maxLength": 96 },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hair", "skin", "body", "accent", "source"],
      "properties": {
        "hair": { "$ref": "#/$defs/rgba" },
        "skin": { "$ref": "#/$defs/rgba" },
        "body": { "$ref": "#/$defs/rgba" },
        "accent": { "$ref": "#/$defs/rgba" },
        "source": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "skill_helper": { "$ref": "#/$defs/boundedText" },
    "runner": { "$ref": "#/$defs/boundedText" },
    "materialized_by": { "$ref": "#/$defs/boundedText" },
    "base_manifest_id": { "type": "string", "pattern": "^pet_[a-z0-9]+$", "maxLength": 128 },
    "base_revision": { "type": "integer", "minimum": 1 },
    "changed_states": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stateName" }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+(?:/[A-Za-z0-9._-]+)?$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "provenance": { "const": "skill-full-source" } },
        "required": ["provenance"]
      },
      "then": {
        "required": ["visual_source", "states", "state_frame_counts", "preview_only"],
        "properties": {
          "visual_source": { "enum": ["image-generation", "user-reference-derived"] },
          "preview_only": { "const": false }
        },
        "not": { "required": ["materialized_by"] }
      }
    }
  ],
  "$defs": {
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "\\S"
    },
    "stateName": {
      "enum": ["idle", "thinking", "tool", "waiting", "done", "failed", "acknowledge", "drag_left", "drag_right"]
    },
    "referencePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "anyOf": [
        { "pattern": "^source/references/[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      ],
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "rgba": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "frameDurations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 40,
      "items": { "type": "integer", "minimum": 50, "maximum": 2000 }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["loop", "periodic", "burst_then_settle", "burst_then_idle", "once_then_return"] },
        "entry_repeat_count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "settle_frame_index": { "type": "integer", "minimum": 0, "maximum": 39 },
        "cooldown_ms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0, "maximum": 86400000 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "loop" } }, "required": ["mode"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["settle_frame_index"] },
                { "required": ["cooldown_ms"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "periodic" } }, "required": ["mode"] },
          "then": {
            "required": ["cooldown_ms"],
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["settle_frame_index"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "burst_then_settle" } }, "required": ["mode"] },
          "then": {
            "required": ["entry_repeat_count", "settle_frame_index"],
            "not": { "required": ["cooldown_ms"] }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "burst_then_idle" } }, "required": ["mode"] },
          "then": {
            "required": ["entry_repeat_count"],
            "not": {
              "anyOf": [
                { "required": ["settle_frame_index"] },
                { "required": ["cooldown_ms"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "once_then_return" } }, "required": ["mode"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["settle_frame_index"] },
                { "required": ["cooldown_ms"] }
              ]
            }
          }
        }
      ]
    },
    "manifestState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "frames_dir",
        "frame_durations_ms",
        "playback",
        "reduced_motion_frame_index"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/stateName" },
        "frames_dir": { "type": "string", "minLength": 1, "maxLength": 240 },
        "frame_durations_ms": { "$ref": "#/$defs/frameDurations" },
        "playback": { "$ref": "#/$defs/playback" },
        "reduced_motion_frame_index": { "type": "integer", "minimum": 0, "maximum": 39 }
      }
    },
    "stateFrameCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idle", "thinking", "tool", "waiting", "done", "failed", "acknowledge", "drag_left", "drag_right"],
      "properties": {
        "idle": { "type": "integer", "minimum": 2, "maximum": 40 },
        "thinking": { "type": "integer", "minimum": 2, "maximum": 40 },
        "tool": { "type": "integer", "minimum": 2, "maximum": 40 },
        "waiting": { "type": "integer", "minimum": 2, "maximum": 40 },
        "done": { "type": "integer", "minimum": 2, "maximum": 40 },
        "failed": { "type": "integer", "minimum": 2, "maximum": 40 },
        "acknowledge": { "type": "integer", "minimum": 2, "maximum": 40 },
        "drag_left": { "type": "integer", "minimum": 2, "maximum": 40 },
        "drag_right": { "type": "integer", "minimum": 2, "maximum": 40 }
      }
    }
  }
}
