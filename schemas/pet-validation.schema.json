{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpetcompanion.local/schemas/pet-validation.schema.json",
  "title": "Agent Pet Companion Pet Validation Artifact — V2 Safe Producer Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok"],
  "properties": {
    "schema_version": { "const": "apc.pet-validation.v1" },
    "ok": { "const": true },
    "validator": { "$ref": "#/$defs/boundedText" },
    "validator_version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
    "validated_at": { "type": "string", "format": "date-time" },
    "manifest_id": { "type": "string", "pattern": "^pet_[a-z0-9]+$", "maxLength": 128 },
    "manifest": { "type": "object" },
    "frame_count": { "type": "integer", "minimum": 12, "maximum": 240 },
    "states": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/manifestState" }
    },
    "state_frame_counts": { "$ref": "#/$defs/stateFrameCounts" },
    "timing_warnings": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "warnings": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "generator": { "$ref": "#/$defs/boundedText" },
    "provenance": { "$ref": "#/$defs/boundedText" },
    "skill_helper": { "$ref": "#/$defs/boundedText" },
    "preview_only": { "type": "boolean" },
    "skipped": { "type": "string", "minLength": 1, "maxLength": 500 },
    "repaired_by": { "$ref": "#/$defs/boundedText" },
    "materialized_by": { "$ref": "#/$defs/boundedText" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+(?:/[A-Za-z0-9._-]+)?$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ok": { "const": true } },
        "required": ["ok"]
      },
      "then": {
        "required": ["frame_count", "states", "state_frame_counts"]
      }
    }
  ],
  "$defs": {
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "\\S"
    },
    "stateName": {
      "enum": ["idle", "thinking", "tool", "waiting", "done", "failed", "acknowledge", "drag_left", "drag_right"]
    },
    "frameDurations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 40,
      "items": { "type": "integer", "minimum": 50, "maximum": 2000 }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["loop", "periodic", "burst_then_settle", "burst_then_idle", "once_then_return"] },
        "entry_repeat_count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "settle_frame_index": { "type": "integer", "minimum": 0, "maximum": 39 },
        "cooldown_ms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0, "maximum": 86400000 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "loop" } }, "required": ["mode"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["settle_frame_index"] },
                { "required": ["cooldown_ms"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "periodic" } }, "required": ["mode"] },
          "then": {
            "required": ["cooldown_ms"],
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["settle_frame_index"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "burst_then_settle" } }, "required": ["mode"] },
          "then": {
            "required": ["entry_repeat_count", "settle_frame_index"],
            "not": { "required": ["cooldown_ms"] }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "burst_then_idle" } }, "required": ["mode"] },
          "then": {
            "required": ["entry_repeat_count"],
            "not": {
              "anyOf": [
                { "required": ["settle_frame_index"] },
                { "required": ["cooldown_ms"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "once_then_return" } }, "required": ["mode"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["settle_frame_index"] },
                { "required": ["cooldown_ms"] }
              ]
            }
          }
        }
      ]
    },
    "manifestState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "frames_dir",
        "frame_durations_ms",
        "playback",
        "reduced_motion_frame_index"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/stateName" },
        "frames_dir": { "type": "string", "minLength": 1, "maxLength": 240 },
        "frame_durations_ms": { "$ref": "#/$defs/frameDurations" },
        "playback": { "$ref": "#/$defs/playback" },
        "reduced_motion_frame_index": { "type": "integer", "minimum": 0, "maximum": 39 }
      }
    },
    "stateFrameCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idle", "thinking", "tool", "waiting", "done", "failed", "acknowledge", "drag_left", "drag_right"],
      "properties": {
        "idle": { "type": "integer", "minimum": 2, "maximum": 40 },
        "thinking": { "type": "integer", "minimum": 2, "maximum": 40 },
        "tool": { "type": "integer", "minimum": 2, "maximum": 40 },
        "waiting": { "type": "integer", "minimum": 2, "maximum": 40 },
        "done": { "type": "integer", "minimum": 2, "maximum": 40 },
        "failed": { "type": "integer", "minimum": 2, "maximum": 40 },
        "acknowledge": { "type": "integer", "minimum": 2, "maximum": 40 },
        "drag_left": { "type": "integer", "minimum": 2, "maximum": 40 },
        "drag_right": { "type": "integer", "minimum": 2, "maximum": 40 }
      }
    }
  }
}
