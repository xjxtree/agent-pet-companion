{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpetcompanion.local/schemas/pet-source-event.schema.json",
  "title": "Agent Pet Companion Pet Source Event — V2 Privacy-Safe Producer Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event"],
  "properties": {
    "schema_version": { "const": "apc.pet-source-event.v1" },
    "event": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "skill": { "$ref": "#/$defs/boundedText" },
    "runner": { "$ref": "#/$defs/boundedText" },
    "helper": { "$ref": "#/$defs/boundedText" },
    "generator": { "$ref": "#/$defs/boundedText" },
    "provenance": { "$ref": "#/$defs/boundedText" },
    "materializer": { "$ref": "#/$defs/boundedText" },
    "manifest_id": { "type": "string", "pattern": "^pet_[a-z0-9]+$", "maxLength": 128 },
    "petpack_source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "style": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
    "quality": { "enum": ["low", "standard"] },
    "render_size": { "$ref": "#/$defs/renderSize" },
    "states": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stateName" }
    },
    "changed_states": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stateName" }
    },
    "state_timings": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/manifestState" }
    },
    "state_frame_counts": { "$ref": "#/$defs/stateFrameCounts" },
    "completed": { "type": "boolean" },
    "validation_ok": { "type": "boolean" },
    "reference_count": { "type": "integer", "minimum": 0, "maximum": 4 },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+(?:/[A-Za-z0-9._-]+)?$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event": { "const": "states.rendered" } },
        "required": ["event"]
      },
      "then": {
        "required": ["states", "state_timings", "state_frame_counts"]
      }
    },
    {
      "if": { "properties": { "quality": { "const": "low" } }, "required": ["quality"] },
      "then": { "properties": { "render_size": { "$ref": "#/$defs/lowSize" } } }
    },
    {
      "if": { "properties": { "quality": { "const": "standard" } }, "required": ["quality"] },
      "then": { "properties": { "render_size": { "$ref": "#/$defs/standardSize" } } }
    }
  ],
  "$defs": {
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "\\S"
    },
    "stateName": {
      "enum": ["idle", "start", "tool", "waiting", "review", "done", "failed"]
    },
    "renderSize": {
      "oneOf": [
        { "$ref": "#/$defs/lowSize" },
        { "$ref": "#/$defs/standardSize" }
      ]
    },
    "renderSizeShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "lowSize": {
      "$ref": "#/$defs/renderSizeShape",
      "properties": { "width": { "const": 192 }, "height": { "const": 208 } }
    },
    "standardSize": {
      "$ref": "#/$defs/renderSizeShape",
      "properties": { "width": { "const": 384 }, "height": { "const": 416 } }
    },
    "frameDurations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 40,
      "items": { "type": "integer", "minimum": 50, "maximum": 2000 }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["loop", "once_hold", "periodic", "burst_then_settle"] },
        "entry_repeat_count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "settle_frame_index": { "type": "integer", "minimum": 0, "maximum": 39 },
        "cooldown_ms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0, "maximum": 86400000 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "loop" } }, "required": ["mode"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["settle_frame_index"] },
                { "required": ["cooldown_ms"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "once_hold" } }, "required": ["mode"] },
          "then": {
            "required": ["settle_frame_index"],
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["cooldown_ms"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "periodic" } }, "required": ["mode"] },
          "then": {
            "required": ["cooldown_ms"],
            "not": {
              "anyOf": [
                { "required": ["entry_repeat_count"] },
                { "required": ["settle_frame_index"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "burst_then_settle" } }, "required": ["mode"] },
          "then": {
            "required": ["entry_repeat_count", "settle_frame_index"],
            "not": { "required": ["cooldown_ms"] }
          }
        }
      ]
    },
    "manifestState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "frames_dir",
        "frame_durations_ms",
        "playback",
        "reduced_motion_frame_index"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/stateName" },
        "frames_dir": { "type": "string", "minLength": 1, "maxLength": 240 },
        "frame_durations_ms": { "$ref": "#/$defs/frameDurations" },
        "playback": { "$ref": "#/$defs/playback" },
        "reduced_motion_frame_index": { "type": "integer", "minimum": 0, "maximum": 39 }
      }
    },
    "stateFrameCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idle", "start", "tool", "waiting", "review", "done", "failed"],
      "properties": {
        "idle": { "type": "integer", "minimum": 2, "maximum": 40 },
        "start": { "type": "integer", "minimum": 2, "maximum": 40 },
        "tool": { "type": "integer", "minimum": 2, "maximum": 40 },
        "waiting": { "type": "integer", "minimum": 2, "maximum": 40 },
        "review": { "type": "integer", "minimum": 2, "maximum": 40 },
        "done": { "type": "integer", "minimum": 2, "maximum": 40 },
        "failed": { "type": "integer", "minimum": 2, "maximum": 40 }
      }
    }
  }
}
